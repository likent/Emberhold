{
  "name": "emberhold",
  "version": "0.1.0",
  "private": true,
  "description": "Emberhold - build by day, hold the night",
  "scripts": {
    "test": "node tests/run.js",
    "serve": "node -e \"const h=require('http'),f=require('fs');h.createServer((q,s)=>{const p=q.url==='/'?'/index.html':q.url;f.readFile('.'+p,(e,d)=>{if(e){s.writeHead(404);return s.end('not found')}s.writeHead(200,{'content-type':p.endsWith('.html')?'text/html':'text/plain'});s.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "devDependencies": {
    "jsdom": "^24.0.0"
  }
}
